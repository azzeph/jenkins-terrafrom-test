# Libvirt host connection
libvirt_uri = "qemu:///system"

# Libvirt infrastructure settings
storage_pool_name = "default"
network_name      = "default"

# Base cloud image (Ubuntu 22.04 LTS Cloud Image)
base_image_name = "ubuntu-22.04-base.qcow2"
base_image_url  = "https://cloud-images.ubuntu.com/releases/22.04/release/ubuntu-22.04-server-cloudimg-amd64.img"

# Cloud-init authentication
admin_username = "ubuntu"
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyNotRealDoNotUseInProdPlaceholder user@workstation"

# Virtual machines configuration
vms = {
  "web-srv-01" = {
    memory        = 2048
    vcpu          = 2
    disk_capacity = 10737418240 # 10 GiB
  }
  "web-srv-02" = {
    memory        = 2048
    vcpu          = 2
    disk_capacity = 10737418240 # 10 GiB
  }
}
